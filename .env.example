# Address to listen on. Use 0.0.0.0 (or ::) to accept connections from other devices.
HOST=127.0.0.1
# Port to listen on (1-65535).
PORT=8790
# Header carrying the real client IP when behind a proxy (rate limiting).
# cf-connecting-ip for Cloudflare; leave unset if clients connect directly.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
